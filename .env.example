# ── Agentic OS configuration ──────────────────────────────────────────────
# Copy to .env and adjust. All values have safe defaults for local dev.

# Event bus: local | redis | nats  (default: local — zero infra)
BUS_TYPE=local

# Redis Streams adapter (used when BUS_TYPE=redis)
REDIS_URL=redis://localhost:6379/0

# NATS JetStream adapter (used when BUS_TYPE=nats)
NATS_URL=nats://localhost:4222

# Control plane
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
LOG_LEVEL=INFO

# Provider adapters (only what you use needs to be set)
# Claude Code CLI path + auth; the adapter shells out to the CLI.
CLAUDE_CODE_BIN=claude
ANTHROPIC_API_KEY=

# Set to "mock" to use the offline Mock provider (no network, for tests/CI).
PROVIDER_DEFAULT=mock
